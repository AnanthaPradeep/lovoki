# Copy to apps/web/.env.local (git-ignored). Placeholders only: never commit real values.
#
# Data mode:
#   demo      sample people and local state (the Phase 1 experience). Needs no Supabase.
#   supabase  real accounts, onboarding and profile storage.
# If this is "supabase" and the two values below are missing or wrong, the app shows a
# configuration error. It never falls back to demo data silently.
VITE_LOVOKI_MODE=demo

# Browser-safe values from Supabase: Project Settings > API.
# URL:  https://<project-ref>.supabase.co   (local CLI: http://127.0.0.1:54321)
# KEY:  the "anon" / publishable key ONLY.
# NEVER put a service_role or secret key in any VITE_ variable: everything VITE_ is public in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
