# Copy to apps/web/.env.local (git-ignored). Placeholders only: never commit real values.
#
# Data mode:
#   demo      sample people and local state (the Phase 1 experience). Needs no Supabase.
#   supabase  real accounts, onboarding and profile storage.
# If this is "supabase" and the two values below are missing or wrong, the app shows a
# configuration error. It never falls back to demo data silently.
VITE_LOVOKI_MODE=demo

# Browser-safe values from Supabase: Project Settings > API Keys.
# URL:  https://<project-ref>.supabase.co   (local CLI: http://127.0.0.1:54421 for this repo)
# KEY:  the PUBLISHABLE key (sb_publishable_...). The legacy name VITE_SUPABASE_ANON_KEY still works; if both are set the publishable one wins.
# NEVER put a service_role or secret key in any VITE_ variable: everything VITE_ is public in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Cloudflare Turnstile SITE key (public). Absent = no CAPTCHA widget; present = sign-up and password reset require it.
# The matching SECRET key goes only in the Supabase dashboard (Authentication > Attack Protection), never here.
VITE_CAPTCHA_SITE_KEY=
